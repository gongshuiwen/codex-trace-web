{
  "name": "codex-session-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/main.ts\" \"vite --host 127.0.0.1\"",
    "dev:server": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.12.7",
    "js-tiktoken": "1.0.21",
    "lucide-react": "^0.468.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "react-virtuoso": "^4.18.13",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
